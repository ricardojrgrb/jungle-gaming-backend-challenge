# Copie para .env se quiser rodar a aplicação fora do Docker (bun run dev).
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
LOG_PRETTY=true

DATABASE_URL=postgres://wagering:wagering@localhost:5432/wagering

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_WAGER_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_WAGER_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wagering-events.fifo
SQS_MAX_RECEIVE_COUNT=5

# Papéis que esta instância assume. Todas ligadas por padrão; em produção dá
# para separar API de workers só mudando estas flags.
ENABLE_SQS_CONSUMER=true
ENABLE_OUTBOX_PUBLISHER=true
ENABLE_PENDING_REFERENCE_WORKER=true

# Autenticação (ver ARCHITECTURE.md). none = guard desligado.
AUTH_MODE=none
# AUTH_MODE=oidc
# AUTH_ISSUER=http://localhost:8080/realms/wagering
# AUTH_JWKS_URL=http://localhost:8080/realms/wagering/protocol/openid-connect/certs
# AUTH_AUDIENCE=wagering-processor
