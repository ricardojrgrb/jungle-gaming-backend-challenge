{
  "name": "wagering-processor",
  "version": "0.1.0",
  "private": true,
  "description": "Distributed wagering processor - Jungle Gaming technical challenge",
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch run src/main.ts",
    "typecheck": "tsc --noEmit",
    "migration:up": "bun run src/infrastructure/persistence/cli/migrate.ts up",
    "migration:down": "bun run src/infrastructure/persistence/cli/migrate.ts down",
    "migration:status": "bun run src/infrastructure/persistence/cli/migrate.ts status",
    "test": "bun test --timeout 120000",
    "test:unit": "bun test --timeout 120000 test/unit",
    "test:integration": "bun test --timeout 120000 test/integration",
    "test:concurrency": "bun test --timeout 120000 test/concurrency",
    "test:load": "bun run scripts/load-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1156.0",
    "@mikro-orm/core": "6",
    "@mikro-orm/migrations": "6",
    "@mikro-orm/postgresql": "6",
    "@nestjs/common": "11",
    "@nestjs/core": "11",
    "@nestjs/platform-express": "11",
    "decimal.js": "^10.6.0",
    "jose": "^6.2.13",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2"
  }
}
